{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[[...route]].js": {
      "includeFiles": "{*.json,assets/**,outputs/middle-east-jordan-funding-1000-plus/companies.json}"
    }
  }
}
