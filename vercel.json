{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[[...route]].ts": {
      "includeFiles": "{eign_index.companies.json,eign_index.rounds.json,valid links.json,assets/table-preferences.json,assets/newsletter-research.csv,assets/companies/**}"
    }
  }
}
